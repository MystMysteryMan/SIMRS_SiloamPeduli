# SIMRS Siloam Peduli - Environment Configuration Template
APP_NAME="SIMRS Siloam Peduli"
APP_ENV="production"
APP_VERSION="5.1.0"
APP_URL="http://localhost:8000"

DB_CONNECTION="pgsql"

# Supabase Managed PostgreSQL Configuration (Singapore ap-southeast-1)
DB_HOST="aws-0-ap-southeast-1.pooler.supabase.com"
DB_PORT="6543"
DB_NAME="postgres"
DB_USER="postgres.YOUR_PROJECT_REF"
DB_PASS="YOUR_SUPABASE_PASSWORD"
DB_SSLMODE="require"

# Supabase API & Cloud Storage Configuration
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SECRET_KEY"
SUPABASE_STORAGE_BUCKET="simrs-radiology"

# Fallback Local MySQL Database
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_NAME="simrs_siloam"
MYSQL_USER="root"
MYSQL_PASS=""
